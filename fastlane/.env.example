# Copy to fastlane/.env (never commit it). fastlane loads it on every run.

# App Store Connect API key: App Store Connect → Users and Access → Integrations →
# App Store Connect API → Team Keys → "+", role App Manager. Download the .p8 once and keep it outside the repo.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# Only for the two one-time lanes that Apple does not allow through the API key
# (create_app, privacy): your Apple ID. fastlane asks for the password and the 2FA code.
FASTLANE_USER=you@example.com
