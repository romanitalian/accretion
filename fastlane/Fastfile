# App Store publishing for Accretion. Run through the Makefile (`make help`, section "Store").
#
# Store listing lives in files next to this one:
#   metadata/<locale>/*.txt   name, subtitle, description, keywords, URLs
#   metadata/*.txt            category, copyright; metadata/review_information/ — contact for App Review
#   rating.json               age rating questionnaire (Apple's 2025 questions included)
#   app_privacy_details.json  App Privacy answers ("Data not collected")
#   screenshots/<locale>/     filled by `make store-screenshots` from the latest screenshots run
#
# Version and build come from VERSION.md, the same file Xcode builds use.

default_platform(:ios)

# Lane code runs inside fastlane/, actions run from the project root: absolute paths avoid the mix-up.
ROOT = File.expand_path(Dir.exist?("fastlane") ? "." : "..")
FL = File.join(ROOT, "fastlane")

def registry
  text = File.read(File.join(ROOT, "VERSION.md"))
  block = text[/```version-registry\n(.*?)```/m, 1] or UI.user_error!("No version-registry block in VERSION.md")
  block.lines.map(&:strip).reject { |l| l.empty? || l.start_with?("#") }.to_h { |l| l.split("=", 2) }
end

# App Store Connect API key from fastlane/.env (see .env.example). Also signs Spaceship in for the build lookup.
def api_key
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |key|
    UI.user_error!("#{key} is not set: copy fastlane/.env.example to fastlane/.env and fill it in") if ENV[key].to_s.empty?
  end
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: File.expand_path(ENV["ASC_KEY_PATH"]),
    duration: 1200
  )
end

def deliver_options(version)
  screenshots = File.join(FL, "screenshots")
  {
    api_key: api_key,
    app_version: version,
    metadata_path: File.join(FL, "metadata"),
    screenshots_path: screenshots,
    app_rating_config_path: File.join(FL, "rating.json"),
    skip_binary_upload: true,
    skip_screenshots: !Dir.exist?(screenshots),
    overwrite_screenshots: true,
    # In-app purchases can't be checked with an API key, and the app has none.
    precheck_include_in_app_purchases: false,
    force: true # no HTML preview; the Makefile asks before anything is submitted
  }
end

platform :ios do
  desc "Check the API key (read-only): signs in and looks up the app record"
  lane :auth do
    api_key
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    if app
      UI.success("API key works. App record: #{app.name} (#{bundle_id})")
    else
      UI.important("API key works. No app record for #{bundle_id} yet: run `make store-create-app`")
    end
  end

  desc "One time, Apple ID: create the App Store Connect record (the API does not allow it)"
  lane :create_app do
    UI.user_error!("Set FASTLANE_USER (your Apple ID) in fastlane/.env") if ENV["FASTLANE_USER"].to_s.empty?
    produce(
      app_name: ENV.fetch("APP_NAME", "Accretion"),
      sku: "accretion",
      language: "en-US",
      app_version: registry["MARKETING_VERSION"],
      platforms: ["ios"]
    )
  end

  desc "One time, Apple ID: answer App Privacy as 'Data not collected'"
  lane :privacy do
    UI.user_error!("Set FASTLANE_USER (your Apple ID) in fastlane/.env") if ENV["FASTLANE_USER"].to_s.empty?
    upload_app_privacy_details_to_app_store(
      json_path: File.join(FL, "app_privacy_details.json")
    )
  end

  desc "Upload texts, category, age rating and screenshots. Nothing is submitted."
  lane :metadata do
    version = registry["MARKETING_VERSION"]
    deliver(**deliver_options(version), submit_for_review: false)
    UI.success("Store listing for #{version} is up to date in App Store Connect")
  end

  desc "Pick the uploaded build from VERSION.md and submit the version for App Review"
  lane :submit do
    reg = registry
    version = reg["MARKETING_VERSION"]
    build = reg["APP_BUILD"]
    options = deliver_options(version)
    wait_for_build(version, build)
    deliver(
      **options,
      skip_screenshots: true, # `make store-metadata` uploads them; resending is slow
      build_number: build,
      submit_for_review: true,
      automatic_release: true,
      submission_information: { add_id_info_uses_idfa: false }
    )
    UI.success("Accretion #{version} (#{build}) is submitted for review")
  end
end

# Apple processes an upload for 5–30 minutes; submitting before that fails.
def wait_for_build(version, build)
  app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
  UI.user_error!("App record not found in App Store Connect: run `make store-create-app` first") unless app
  60.times do
    found = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build).first
    if found.nil?
      UI.message("Build #{version} (#{build}) is not in App Store Connect yet — waiting (did `make testflight` run?)")
    elsif found.processed?
      UI.success("Build #{version} (#{build}) is processed")
      return
    else
      UI.message("Build #{version} (#{build}) is still processing — waiting")
    end
    sleep(30)
  end
  UI.user_error!("Build #{version} (#{build}) did not finish processing in 30 minutes")
end
